# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# In production these are fly secrets (`fly secrets set KEY=value --app mytetz`)
# except the non-sensitive ones, which live in fly.toml's [env] block.

# MongoDB Atlas connection string (never commit the real one).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mytetz

# Anthropic API key — backend only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Engine configuration (all optional; defaults in code).
#
# Every one of these falls back to its default if unset, unparseable or non-positive: they are read
# while the process is starting, and a typo in a deployment variable must not take the server down.
# MYTETZ_COOKIE_SIGNING_KEY below is the ONE exception, deliberately — see the note on it.
MYTETZ_MODEL_ID=claude-opus-5
MYTETZ_MODEL_FAMILY=claude-opus-5
MYTETZ_EFFORT=LOW
MYTETZ_MAX_OUTPUT_TOKENS=4000
MYTETZ_MAX_DEPTH=12
MYTETZ_MAX_SESSION_NODES=200
MYTETZ_MAX_VARIANTS=3
MYTETZ_DAILY_EXPLAINS=20
MYTETZ_GLOBAL_DAILY_COST_CEILING_USD_MICROS=50000000
MYTETZ_WEB_TOOL_ENABLED=false

# Largest number of distinct rows POST /api/topic-requests may create. Bounds the collection under
# spam; repeats of text already stored keep counting once it is reached.
MYTETZ_MAX_TOPIC_REQUESTS=5000

# REQUIRED. Signs the anonymous principal cookie. 32 characters minimum.
#
# The server REFUSES TO START without it, and that is correct rather than an oversight: a defaulted
# signing key would let anyone mint any principal — a free quota reset today, somebody else's
# account once user principals exist. There is no safe default, so the safe failure is to refuse.
# Do not "fix" this into a fallback to match the resolvers above.
#
#     openssl rand -base64 32
#
# Local:      put the generated value on the line below.
# Production: fly secrets set MYTETZ_COOKIE_SIGNING_KEY="$(openssl rand -base64 32)" --app mytetz
MYTETZ_COOKIE_SIGNING_KEY=

# Whether the principal cookie carries the Secure attribute. Defaults to TRUE when unset, and only
# an explicit false/0/no/off turns it off — the opposite polarity to the knobs above, because here
# the strict value is the safe one. Never derived from the request's Host header: that is
# client-controlled.
#
# LEFT COMMENTED OUT ON PURPOSE. This file is meant to be copied to `.env`, so a literal `false`
# here is a literal `false` in whatever the operator copies — which is exactly the insecure cookie
# this setting exists to prevent, arrived at by following the instructions. Uncomment it only for a
# local HTTP server, and never in production.
#MYTETZ_COOKIE_SECURE=false

# Header carrying the real client address, used to rate-limit POST /api/topic-requests.
#
# UNSET MEANS "TRUST NO HEADER", and that is the safe default: a header the caller can set is a
# rate-limit bucket the caller can choose. Set it only once you know which proxy terminates traffic,
# because the value is only as trustworthy as the hop that overwrites it.
#
# On this deployment the chain is browser -> Cloudflare (proxied) -> fly.io -> app, so:
#   CF-Connecting-IP  the visitor's real address; correct for traffic through Cloudflare, but
#                     forgeable by anyone who reaches mytetz.fly.dev directly.
#   Fly-Client-IP     written by fly's proxy and unforgeable, but behind Cloudflare it is the
#                     Cloudflare edge, so it groups everyone sharing that edge into one bucket.
# The limiter's key ceiling bounds memory whichever you pick, including when the value is forged.
#MYTETZ_CLIENT_IP_HEADER=CF-Connecting-IP

# Port the Ktor server binds. Defaults to 8080 in code; fly.toml sets it too.
PORT=8080
