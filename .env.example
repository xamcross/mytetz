# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# In production these are fly secrets (`fly secrets set KEY=value --app mytetz`)
# except the non-sensitive ones, which live in fly.toml's [env] block.

# MongoDB Atlas connection string (never commit the real one).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mytetz

# How long the driver looks for a reachable server before it fails an operation. The driver default
# is 30 seconds, which is too long: /api/health pings Mongo on every request and fly's health check
# allows 5 seconds.
MYTETZ_MONGO_SERVER_SELECTION_TIMEOUT_MILLIS=3000

# Anthropic API key — backend only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Engine configuration (all optional; defaults in code).
#
# Every one of these falls back to its default if unset, unparseable or non-positive: they are read
# while the process is starting, and a typo in a deployment variable must not take the server down.
# MYTETZ_COOKIE_SIGNING_KEY below is the ONE exception, deliberately — see the note on it.
# The model, and the family that is hashed into every content key.
#
# Sonnet 5 costs $3 and $15 for each 1M tokens. Opus 5 costs $5 and $25. One explanation is about
# 1000 input tokens and 500 output tokens. The two costs are therefore $0.0105 and $0.0175. At 25
# explanations each day the month costs $7.88 and $13.13, against $10.29 of net revenue on a €10
# subscription.
#
# CHANGING MYTETZ_MODEL_FAMILY ORPHANS EVERY EXPLANATION IN THE STORE. That is designed behaviour.
# The family is part of the content key. A change therefore invalidates the cache with no
# migration. Read section 13 of docs/superpowers/specs/2026-08-07-monetization-design.md before
# you change it. Run the migration in MYTETZ_MIGRATE_ON_BOOT below to remove the documents it
# strands.
MYTETZ_MODEL_ID=claude-sonnet-5
MYTETZ_MODEL_FAMILY=claude-sonnet-5
MYTETZ_EFFORT=LOW
MYTETZ_MAX_OUTPUT_TOKENS=4000
MYTETZ_MAX_DEPTH=12
MYTETZ_MAX_SESSION_NODES=200
MYTETZ_MAX_VARIANTS=3
MYTETZ_DAILY_EXPLAINS=20

# Timeout for one streamed model request, in seconds. It also bounds how long a stalled read holds
# an IO thread, because the SDK cannot abort one. A healthy explanation completes in seconds.
MYTETZ_LLM_TIMEOUT_SECONDS=120

# THE ONLY SPEND BRAKE IN THE SYSTEM. Read this before you change it.
#
# The unit is USD micro-dollars, so 50000000 is $50. The value is a ceiling on the total cost of
# all generation in one UTC day, across every visitor.
#
# When the day's recorded spend reaches this ceiling, the server stops NEW generation and keeps
# serving explanations that it already holds. The site stays usable and it stops costing money.
# Lower this value to slow a runaway bill. Set it with `fly secrets set` and the machine restarts.
#
# The ceiling does not cover every path. A request that ends before the model stream completes
# records no cost, because no token count exists for it. The per-address rate limit in
# `SessionRoutes.kt` is what bounds that path.
MYTETZ_GLOBAL_DAILY_COST_CEILING_USD_MICROS=50000000

# Largest number of distinct rows POST /api/topic-requests may create. Bounds the collection under
# spam; repeats of text already stored keep counting once it is reached.
MYTETZ_MAX_TOPIC_REQUESTS=5000

# NO DEFAULT. The absolute base url of this deployment.
#
# A magic link and a Google OAuth redirect both need an absolute url. The server refuses to start
# a sign-in flow without it: `POST /api/auth/magic-link` and `GET /api/auth/google` each build one
# from this value the first time either route runs. The catalogue and the reader do not need it.
MYTETZ_PUBLIC_BASE_URL=

# NO DEFAULT for either value. From Google Cloud Console.
#
# The server refuses a Google sign-in without both values set — `GET /api/auth/google` throws the
# first time it runs. The magic link still works with neither set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NO DEFAULT. `resend` or `log`.
#
# The server refuses a magic-link sign-in without this set — `POST /api/auth/magic-link` throws the
# first time it runs. `log` writes the link at INFO instead of mailing it, for local work. Google
# sign-in still works with this unset.
MYTETZ_MAIL_MODE=

# NO DEFAULT for either value, and both are read only when MYTETZ_MAIL_MODE=resend.
#
# The Resend API key and the "From" address. The server refuses a magic-link sign-in in resend mode
# without both set.
MYTETZ_MAIL_API_KEY=
MYTETZ_MAIL_FROM=

# REQUIRED. Signs the anonymous principal cookie. 32 characters minimum.
#
# The server REFUSES TO START without it, and that is correct rather than an oversight: a defaulted
# signing key would let anyone mint any principal — a free quota reset today, somebody else's
# account once user principals exist. There is no safe default, so the safe failure is to refuse.
# Do not "fix" this into a fallback to match the resolvers above.
#
#     openssl rand -base64 32
#
# Local:      put the generated value on the line below.
# Production: fly secrets set MYTETZ_COOKIE_SIGNING_KEY="$(openssl rand -base64 32)" --app mytetz
MYTETZ_COOKIE_SIGNING_KEY=

# Whether the principal cookie carries the Secure attribute. Defaults to TRUE when unset, and only
# an explicit false/0/no/off turns it off — the opposite polarity to the knobs above, because here
# the strict value is the safe one. Never derived from the request's Host header: that is
# client-controlled.
#
# LEFT COMMENTED OUT ON PURPOSE. This file is meant to be copied to `.env`, so a literal `false`
# here is a literal `false` in whatever the operator copies — which is exactly the insecure cookie
# this setting exists to prevent, arrived at by following the instructions. Uncomment it only for a
# local HTTP server, and never in production.
#MYTETZ_COOKIE_SECURE=false

# Header carrying the real client address. The rate limiters key on it. They protect
# POST /api/topic-requests, POST /api/sessions and POST /api/sessions/{id}/explain.
#
# UNSET MEANS Fly-Client-IP. That is deliberate and it is not the strictest option: the strictest
# option — trusting no header — leaves the raw socket peer as the key, which on a proxied deployment
# is ONE ADDRESS FOR EVERY VISITOR, so the whole internet would share a single daily allowance.
# A coarse key beats no key.
#
# On this deployment the chain is browser -> Cloudflare (proxied) -> fly.io -> app, so:
#   CF-Connecting-IP  the visitor's real address, one bucket per visitor. Forgeable by anyone who
#                     reaches mytetz.fly.dev directly, bypassing Cloudflare. This is what fly.toml
#                     sets in production; the evasion is bounded by the limiter's key ceiling.
#   Fly-Client-IP     set by fly's proxy, so unforgeable — but behind Cloudflare it resolves to the
#                     Cloudflare edge, so everyone sharing an edge shares one allowance. The default.
#   none              trust nothing. Only correct behind no proxy you control; see the warning above.
#
# The server accepts only a name that it knows: Fly-Client-IP, CF-Connecting-IP, True-Client-IP,
# X-Forwarded-For, X-Real-IP, or `none`. Case does not matter. The server rejects any other value,
# logs a WARN line, and uses Fly-Client-IP. This stops a typo from making every visitor share one
# bucket, which is what a name that no request carries does. The server also logs the resolved
# source once at startup. Grep the boot log for "rate limiting keys on".
#
# Locally neither header is present, so any setting falls back to the socket peer, which is fine
# when the socket peer really is the client.
#MYTETZ_CLIENT_IP_HEADER=CF-Connecting-IP

# Port the Ktor server binds. Defaults to 8080 in code; fly.toml sets it too.
PORT=8080

# ONE-TIME MIGRATION. Leave this unset.
#
# Set it to exactly `true` for one deployment after you change MYTETZ_MODEL_FAMILY, then remove it.
# It does two things at boot, in this order:
#
#   1. Deletes every explanation whose model family is not the current one. Those documents are
#      unreachable, because the family is part of the content key.
#   2. Generates a seed explanation for every published topic that has none.
#
# Step 2 spends real money — about $0.30 for 29 topics. It also forces the model client to build.
# Set ANTHROPIC_API_KEY before you run it. Confirm the account holds credit. The loop stops early
# if the global spend breaker trips.
#
# Both steps are idempotent. Grep the boot log for "MIGRATION" to see what happened.
#
#MYTETZ_MIGRATE_ON_BOOT=true
